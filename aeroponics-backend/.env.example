# =====================================================
# Aeroponics Backend — Environment Variables Template
# =====================================================

PORT=3001
JWT_SECRET=aeroponics_super_secret_jwt_key_default_32chars
CORS_ORIGIN=http://localhost:3000

# Database (TimescaleDB / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aeroponics_user
DB_PASS=aeroponics_pass
DB_NAME=aeroponics

# MQTT Broker (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=aero_backend
MQTT_PASSWORD=aero_backend_pass

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Aeroponics2026!
