# =====================================================
# AEROPONICS LAB — Environment Variables Template
# cp .env.example .env  → điền giá trị thật
# KHÔNG commit .env vào git!
# =====================================================

# --- TimescaleDB / PostgreSQL ---
DB_USER=aeroponics_user
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=aeroponics

# --- MQTT Broker (Mosquitto) ---
# Public port 11883 avoids clashing with mushroom-cp (port 10883)
MQTT_PORT=11883
MQTT_WS_PORT=19001
MQTT_ADMIN_USER=mqtt_admin
MQTT_ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD
# Golden rule: MQTT_DEVICE_USER must match MQTT_DEVICE_ID for ACL (%u)
MQTT_DEVICE_USER=esp32_device
MQTT_DEVICE_PASS=CHANGE_ME_DEVICE_PASSWORD
MQTT_DEVICE_ID=esp32_device
MQTT_BACKEND_USER=aero_backend
MQTT_BACKEND_PASS=CHANGE_ME_BACKEND_PASSWORD

# --- NestJS Backend ---
BACKEND_PORT=3001
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
CORS_ORIGIN=http://localhost:3000

# --- Nginx Reverse Proxy ---
# Open port on VM Host for aeroponics (web/API entrypoint)
PROXY_PORT=6003


# --- Tuya Bridge (tích hợp trong Backend - On-demand & End-of-Season) ---
# Đặt false khi chưa vào giai đoạn đo vụ cuối để bảo vệ đầu dò pH/EC/ORP và tránh timeout socket
TUYA_BRIDGE_ENABLED=false
TUYA_DEVICE_IP=192.168.1.XXX
TUYA_DEVICE_ID=CHANGE_ME_TUYA_DEVICE_ID
TUYA_LOCAL_KEY=CHANGE_ME_16_CHARS_LOCAL_KEY
TUYA_SENSOR_ID=ph-w218-01
TUYA_ON_DEMAND_TIMEOUT_MS=5000

# --- ESP32 Firmware (tham khảo) ---
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password
DEVICE_ID=esp32_device
