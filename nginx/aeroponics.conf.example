# ============================================================
# Nginx Reverse Proxy — Aeroponics Smart Farm
# Copy sang /etc/nginx/sites-available/aeroponics.conf
# Thay thế domain.com bằng domain thực
# ============================================================

upstream aero_ui {
    server aero-ui:3000;
    keepalive 32;
}

upstream aero_backend {
    server aero-backend:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name domain.com www.domain.com;

    # Redirect HTTP → HTTPS (uncomment khi có SSL)
    # return 301 https://$host$request_uri;

    # === WebSocket — PHẢI khai báo TRƯỚC /api/ và / ===
    location /ws {
        proxy_pass http://aero_backend;
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout cho long-lived WS connection
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # === NestJS REST API ===
    location /api/ {
        proxy_pass http://aero_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers từ NestJS — không double-set ở Nginx
        proxy_pass_header Access-Control-Allow-Origin;
    }

    # === Next.js App (catch-all) ===
    location / {
        proxy_pass http://aero_ui;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
