# ==============================================================================
# Aeroponics Lean — Mosquitto Access Control List (ACL)
# ==============================================================================

# Gateway credentials are per-device identities.  The provisioned MQTT username,
# MQTT client ID and device_id must be the same safe identifier.  `%u` binds the
# topic namespace to the authenticated username, preventing cross-gateway I/O.
pattern write aeroponics/device/%u/status
pattern write aeroponics/device/%u/telemetry/#
pattern write aeroponics/device/%u/ack/#
pattern read  aeroponics/device/%u/command/#
pattern read  aeroponics/device/%u/config/#

user aero_backend
topic read  aeroponics/device/+/status
topic read  aeroponics/device/+/telemetry/#
topic read  aeroponics/device/+/ack/#
topic write aeroponics/device/+/command/#
topic write aeroponics/device/+/config/#
topic write aeroponics/sensor/+/reading

# Admin (debug)
user mqtt_admin
topic readwrite #
