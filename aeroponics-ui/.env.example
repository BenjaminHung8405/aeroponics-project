# === Aeroponics UI — Environment Variables ===
# Tài liệu: sprint_4.md §1.1 Deployment & Nginx Routing

# Production (Nginx same-origin proxy):
# Để TRỐNG — Next.js sẽ tự dùng /api và /ws qua same-origin
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Local development: đổi tên file này thành .env.local (không commit)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
